# Next emits the generated metadata images as extensionless files, so the host
# cannot infer their type. Without these the favicon and social card are served
# as application/octet-stream and silently fail.
/icon
  Content-Type: image/png
  Cache-Control: public, max-age=3600

/opengraph-image
  Content-Type: image/png
  Cache-Control: public, max-age=3600

# Build assets are content-hashed, so they can be cached indefinitely.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
